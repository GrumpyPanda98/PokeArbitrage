# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
next-dev*.log
tools/**/*.log

# python tooling/runtime state
**/.venv/
**/__pycache__/
*.py[cod]

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local handoff/archive files
*_handoff.zip

# local browser profiles/session state
tools/**/.cardmarket-profile/

# Share only the placeholder configuration, never credentials or local captures.
!.env.example
/data/
/logs/
