# Optional local settings. Never put secret values in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_POKEARB_PASSCODE=Japan
# Comma-separated extra development hostnames, without scheme or port.
POKEARB_DEV_ORIGINS=

# Local image matcher: omit to use tools/card_matcher/.venv.
# LOCAL_CARD_MATCHER_PYTHON=/absolute/path/to/python
LOCAL_CARD_MATCHER_DEVICE=cpu
SCAN_PROVIDER_ORDER=local-image

# Optional local services. Keep account-backed services on loopback.
PRICE_OCR_URL=http://127.0.0.1:8765/ocr-price
CARDMARKET_LIVE_ENABLED=false
CARDMARKET_SIDECAR_AUTO_START=false
CARDMARKET_SIDECAR_URL=http://127.0.0.1:8766/cardmarket/raw-price
# CM_USERNAME=
# CM_PASSWORD=
# CARDMARKET_ENV_FILE=/absolute/path/to/private.env

# Optional external scan providers; photos are sent to the selected service.
# GIBLTCG_API_KEY=
# GOOGLE_VISION_API_KEY=
